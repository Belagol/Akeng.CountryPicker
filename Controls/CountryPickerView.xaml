<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AkengCountryPicker.Controls.CountryPickerView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AkengCountryPicker.Controls"
    xmlns:models="clr-namespace:AkengCountryPicker.Models"
    x:Name="root">

    <ContentView.Resources>
        <ResourceDictionary>

            <!--  Existing theme dictionaries  -->

            <!--  Default template  -->
            <DataTemplate x:Key="DefaultCountryTemplate" x:DataType="models:CountryInfo">
                <Grid
                    Padding="12,6"
                    ColumnDefinitions="40,*,Auto,Auto,44"
                    HeightRequest="52">

                    <Label
                        FontSize="24"
                        IsVisible="{Binding ShowEmoji, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                        Text="{Binding FlagEmoji}"
                        VerticalOptions="Center" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Margin="8,0"
                        Spacing="1"
                        VerticalOptions="Center">

                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            LineBreakMode="TailTruncation"
                            Text="{Binding Name}"
                            TextColor="{DynamicResource CountryPickerPrimaryTextColor}" />

                        <Label
                            FontSize="12"
                            IsVisible="{Binding ShowNativeName, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                            LineBreakMode="TailTruncation"
                            Text="{Binding NativeName}"
                            TextColor="{DynamicResource CountryPickerSecondaryTextColor}" />

                    </VerticalStackLayout>

                    <Label
                        Grid.Column="2"
                        FontSize="15"
                        IsVisible="{Binding ShowDialCode, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                        Text="{Binding DialCode}"
                        TextColor="{DynamicResource CountryPickerSecondaryTextColor}"
                        VerticalOptions="Center" />

                    <VerticalStackLayout
                        Grid.Column="3"
                        Margin="8,0"
                        Spacing="1"
                        VerticalOptions="Center">

                        <Label
                            FontSize="13"
                            IsVisible="{Binding ShowIso2, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                            Text="{Binding Iso2}"
                            TextColor="{DynamicResource CountryPickerSecondaryTextColor}" />

                        <Label
                            FontSize="13"
                            IsVisible="{Binding ShowIso3, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                            Text="{Binding Iso3}"
                            TextColor="{DynamicResource CountryPickerSecondaryTextColor}" />

                    </VerticalStackLayout>

                    <Button
                        Grid.Column="4"
                        Padding="0"
                        BackgroundColor="Transparent"
                        Clicked="OnFavoriteClicked"
                        FontSize="22"
                        IsVisible="{Binding AllowFavoriteSelection, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                        Text="{Binding FavoriteIcon}"
                        TextColor="{DynamicResource CountryPickerFavoriteColor}"
                        VerticalOptions="Center" />

                </Grid>
            </DataTemplate>

            <!--  Compact template  -->
            <DataTemplate x:Key="CompactCountryTemplate" x:DataType="models:CountryInfo">
                <Grid
                    Padding="12,6"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="10"
                    HeightRequest="52">

                    <Label
                        FontSize="30"
                        IsVisible="{Binding ShowEmoji, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                        Text="{Binding FlagEmoji}"
                        VerticalOptions="Center" />


                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="16"
                        LineBreakMode="TailTruncation"
                        Text="{Binding Name}"
                        TextColor="{DynamicResource CountryPickerPrimaryTextColor}"
                        VerticalOptions="Center" />

                    <Button
                        Grid.Column="2"
                        Padding="0"
                        BackgroundColor="Transparent"
                        Clicked="OnFavoriteClicked"
                        FontSize="22"
                        IsVisible="{Binding AllowFavoriteSelection, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                        Text="{Binding FavoriteIcon}"
                        TextColor="{DynamicResource CountryPickerFavoriteColor}"
                        VerticalOptions="Center" />

                </Grid>
            </DataTemplate>

            <!--  Phone template  -->
            <DataTemplate x:Key="PhoneCountryTemplate" x:DataType="models:CountryInfo">

                <Grid
                    Padding="12,6"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="12"
                    HeightRequest="52"
                    RowDefinitions="Auto,Auto">

                    <Label
                        FontSize="30"
                        IsVisible="{Binding ShowEmoji, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                        Text="{Binding FlagEmoji}"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        FontSize="15"
                        IsVisible="{Binding ShowDialCode, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                        Text="{Binding DialCode}"
                        TextColor="{DynamicResource CountryPickerSecondaryTextColor}"
                        VerticalOptions="Center" />

                    <!--<Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="16"
                        LineBreakMode="TailTruncation"
                        Text="{Binding Name}"
                        TextColor="{DynamicResource CountryPickerPrimaryTextColor}"
                        VerticalOptions="Center" />-->

                    <Button
                        Grid.Column="2"
                        Padding="0"
                        BackgroundColor="Transparent"
                        Clicked="OnFavoriteClicked"
                        FontSize="22"
                        IsVisible="{Binding AllowFavoriteSelection, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                        Text="{Binding FavoriteIcon}"
                        TextColor="{DynamicResource CountryPickerFavoriteColor}"
                        VerticalOptions="Center" />

                </Grid>
            </DataTemplate>

            <!--  ISO template  -->
            <DataTemplate x:Key="IsoCountryTemplate" x:DataType="models:CountryInfo">

                <Grid
                    Padding="12,6"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="12"
                    HeightRequest="52"
                    RowDefinitions="Auto,Auto">

                    <Label
                        FontSize="30"
                        IsVisible="{Binding ShowEmoji, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                        Text="{Binding FlagEmoji}"
                        VerticalOptions="Center" />


                    <!--<Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="16"
                        LineBreakMode="TailTruncation"
                        Text="{Binding Name}"
                        TextColor="{DynamicResource CountryPickerPrimaryTextColor}"
                        VerticalOptions="Center" />-->

                    <VerticalStackLayout
                        Grid.Column="1"
                        Margin="8,0"
                        HorizontalOptions="Center"
                        Spacing="1"
                        VerticalOptions="Center">

                        <Label
                            FontSize="13"
                            IsVisible="{Binding ShowIso2, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                            Text="{Binding Iso2}"
                            TextColor="{DynamicResource CountryPickerSecondaryTextColor}" />

                        <Label
                            FontSize="13"
                            IsVisible="{Binding ShowIso3, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                            Text="{Binding Iso3}"
                            TextColor="{DynamicResource CountryPickerSecondaryTextColor}" />

                    </VerticalStackLayout>

                    <Button
                        Grid.Column="2"
                        Padding="0"
                        BackgroundColor="Transparent"
                        Clicked="OnFavoriteClicked"
                        FontSize="22"
                        IsVisible="{Binding AllowFavoriteSelection, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                        Text="{Binding FavoriteIcon}"
                        TextColor="{DynamicResource CountryPickerFavoriteColor}"
                        VerticalOptions="Center" />

                </Grid>
            </DataTemplate>

            <!--  Native name template  -->
            <DataTemplate x:Key="NativeNameCountryTemplate" x:DataType="models:CountryInfo">

                <Grid
                    Padding="12,6"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="12"
                    HeightRequest="52"
                    RowDefinitions="Auto,Auto">

                    <Label
                        Grid.RowSpan="2"
                        FontSize="30"
                        IsVisible="{Binding ShowEmoji, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                        Text="{Binding FlagEmoji}"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="16"
                        IsVisible="{Binding ShowNativeName, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                        LineBreakMode="TailTruncation"
                        Text="{Binding NativeName}"
                        TextColor="{DynamicResource CountryPickerPrimaryTextColor}"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        FontSize="12"
                        LineBreakMode="TailTruncation"
                        Text="{Binding Name}"
                        TextColor="{DynamicResource CountryPickerSecondaryTextColor}"
                        VerticalOptions="Center" />

                    <Button
                        Grid.RowSpan="2"
                        Grid.Column="2"
                        Padding="0"
                        BackgroundColor="Transparent"
                        Clicked="OnFavoriteClicked"
                        FontSize="22"
                        IsVisible="{Binding AllowFavoriteSelection, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                        Text="{Binding FavoriteIcon}"
                        TextColor="{DynamicResource CountryPickerFavoriteColor}"
                        VerticalOptions="Center" />

                </Grid>
            </DataTemplate>

            <!--  Flag-only template  -->
            <DataTemplate x:Key="FlagOnlyCountryTemplate" x:DataType="models:CountryInfo">

                <Grid
                    Padding="12,6"
                    ColumnDefinitions="*,Auto,*"
                    HeightRequest="52">

                    <Label
                        Grid.Column="1"
                        FontSize="30"
                        HorizontalOptions="Center"
                        IsVisible="{Binding ShowEmoji, Source={RelativeSource AncestorType={x:Type controls:CountryPickerView}}}"
                        Text="{Binding FlagEmoji}"
                        VerticalOptions="Center" />
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </ContentView.Resources>

    <Grid
        BackgroundColor="{DynamicResource CountryPickerBackgroundColor}"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="8">

        <SearchBar
            x:Name="SearchCountryBar"
            BackgroundColor="{DynamicResource CountryPickerSurfaceColor}"
            IsVisible="{Binding ShowSearchBar, Source={x:Reference root}}"
            Placeholder="{Binding Placeholder, Source={x:Reference root}}"
            PlaceholderColor="{DynamicResource CountryPickerSecondaryTextColor}"
            Text="{Binding SearchText, Source={x:Reference root}, Mode=TwoWay}"
            TextChanged="OnSearchTextChanged"
            TextColor="{DynamicResource CountryPickerPrimaryTextColor}" />

        <Label
            x:Name="EmptyMessageLabel"
            Grid.Row="1"
            HorizontalOptions="Center"
            IsVisible="False"
            Text="{Binding EmptyMessage, Source={x:Reference root}}"
            TextColor="Gray" />

        <CollectionView
            x:Name="CountriesCollectionView"
            Grid.Row="2"
            BackgroundColor="{DynamicResource CountryPickerBackgroundColor}"
            IsGrouped="True"
            ItemSizingStrategy="MeasureFirstItem"
            SelectionChanged="OnCountrySelected"
            SelectionMode="Single">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:CountryGroup">
                    <Grid Padding="12,10,12,6" BackgroundColor="{DynamicResource CountryPickerGroupHeaderColor}">
                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="{Binding Title}"
                            TextColor="{DynamicResource CountryPickerPrimaryTextColor}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

